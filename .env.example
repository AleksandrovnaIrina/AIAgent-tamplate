# ═══════════════════════════════════════════
# LumysAgent — Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════

# ── Обов'язкові ─────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# Telegram Bot (отримати у @BotFather)
TELEGRAM_BOT_TOKEN=
# ID чатів що мають доступ до бота (через кому)
# Дізнатись свій ID: написати @userinfobot
TELEGRAM_ALLOWED_CHAT_IDS=
# ID чату куди надсилати Scout-дайджест (зазвичай той самий)
TELEGRAM_DIGEST_CHAT_ID=

# Claude (claude.ai Pro/Max → Settings → API)
CLAUDE_CODE_OAUTH_TOKEN=

# ── Для Auto-Scout ───────────────────────────
# Apify (apify.com) — для Djinni та DOU скрапінгу
APIFY_TOKEN=

# Brave Search API (api.search.brave.com) — для LinkedIn X-Ray
# АБО SerpAPI (serpapi.com) як альтернатива
BRAVE_API_KEY=
# SERPAPI_KEY=

# ── Google Workspace (опціонально) ──────────
# Service Account JSON (одним рядком або base64)
GOOGLE_CREDENTIALS_JSON=
# ID Google Sheets таблиці для трекінгу кандидатів
GOOGLE_SHEET_ID=
# ID Google Calendar для перевірки слотів
GOOGLE_CALENDAR_ID=

# ── Голосові повідомлення (опціонально) ─────
GROQ_API_KEY=

# ── Налаштування агента ──────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TURNS=20
# Cron для Scout: за замовчуванням щопонеділка о 9:00
SCOUT_CRON=0 9 * * 1
# Запустити Scout одразу при старті контейнера
SCOUT_RUN_ON_START=false
